(version 1)

(rule "Ignore_Inside_U1"
  (constraint clearance (min 0mm))
  (condition "A.Reference == '*'"))

(rule "Ignore J2 Edge Clearance"
  (constraint edge_clearance (min 0mm))
  (severity ignore)
  (condition "A.memberOfFootprint('J2') && B.Layer == 'Edge.Cuts'"))

(rule "Ignore Hole Clearance for J Footprint"
  (constraint hole_clearance (min 0mm))
  (condition "A.memberOfFootprint('YOUR_J_FOOTPRINT_REFERENCE')")
)
